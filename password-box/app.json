{
  "expo": {
    "name": "PasswordBox",
    "slug": "password-box",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "passwordbox",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a1a2e"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.passwordbox.app"
    },

    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1a1a2e",
        "foregroundImage": "./assets/foreground.png",
        "backgroundImage": "./assets/background.png",
        "monochromeImage": "./assets/monochrome.png"
      },
      "package": "com.passwordbox.app",
      "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION"]
    },
    "web": {
      "favicon": "./assets/icon.png",
      "bundler": "metro"
    },
    "plugins": [

      "expo-router",
      "expo-secure-store",
      "expo-sharing",
      "expo-document-picker",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Permet d'enregistrer la localisation de vos sites."
        }
      ],


    ]
  }
}
